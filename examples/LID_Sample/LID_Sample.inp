[TITLE]
;;Project Title/Notes
LID sample: the Philadelphia sample sewer with green infrastructure in every subcatchment.
Rain garden and rain barrels (S1), permeable pavement (S2), green roof and bio-retention (S3),
infiltration trench (S4) and a vegetative swale (S5), 2-year design storm.

[OPTIONS]
;;Option             Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           06/01/2024
START_TIME           00:00:00
REPORT_START_DATE    06/01/2024
REPORT_START_TIME    00:00:00
END_DATE             06/01/2024
END_TIME             06:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             5
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         0:00:10
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         12.566
MAX_TRIALS           8
HEAD_TOLERANCE       0.005
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
CONSTANT         0.0
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
RG1              INTENSITY 0:05     1.0      TIMESERIES DESIGN_2YR

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen
S1               RG1              J1               3.2      60       384      1.5      0
S2               RG1              J2               2.6      65       312      1.5      0
S3               RG1              J6               4.1      70       491      1.5      0
S4               RG1              J4               3.5      75       420      1.5      0
S5               RG1              J5               2.8      80       336      1.5      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo
S1               0.012      0.15       0.05       0.2        25         OUTLET
S2               0.012      0.15       0.05       0.2        25         OUTLET
S3               0.012      0.15       0.05       0.2        25         OUTLET
S4               0.012      0.15       0.05       0.2        25         OUTLET
S5               0.012      0.15       0.05       0.2        25         OUTLET

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil
S1               3.0        0.5        4          7          0
S2               3.0        0.5        4          7          0
S3               3.0        0.5        4          7          0
S4               3.0        0.5        4          7          0
S5               3.0        0.5        4          7          0

[LID_CONTROLS]
;;Name           Type/Layer Parameters
;; Rain garden: 6 in ponding over 18 in of planting soil, no underdrain
RainGarden       RG
RainGarden       SURFACE    6          0.1        0.1        1.0        5
RainGarden       SOIL       18         0.5        0.2        0.1        0.5        10         3.5
;; Bio-retention cell with a gravel bed and a slotted underdrain
BioCell          BC
BioCell          SURFACE    6          0.2        0.1        1.0        5
BioCell          SOIL       24         0.5        0.2        0.1        0.5        10         3.5
BioCell          STORAGE    12         0.75       0.5        0
BioCell          DRAIN      0.5        0.5        6          6
;; Permeable pavers over a 12 in stone base
PermPave         PP
PermPave         SURFACE    0.05       0          0.012      1.0        5
PermPave         PAVEMENT   6          0.15       0          100        0
PermPave         STORAGE    12         0.75       0.5        0
PermPave         DRAIN      0          0.5        6          6
;; Extensive green roof
GreenRoof        GR
GreenRoof        SURFACE    3          0          0.1        1.0        5
GreenRoof        SOIL       4          0.5        0.2        0.1        1.0        10         3.5
GreenRoof        DRAINMAT   1          0.5        0.1
;; 55 gallon rain barrel that drains over 6 hours after the rain
RainBarrel       RB
RainBarrel       STORAGE    36         0.75       0          0
RainBarrel       DRAIN      1          0.5        0          6
;; Stone-filled infiltration trench
InfilTrench      IT
InfilTrench      SURFACE    6          0          0.1        1.0        5
InfilTrench      STORAGE    36         0.75       0.5        0
InfilTrench      DRAIN      0          0.5        6          6
;; Grassed swale along the street
Swale            VS
Swale            SURFACE    12         0.2        0.24       1.0        5

[LID_USAGE]
;;Subcatchment   LID Process      Number  Area       Width      InitSat    FromImp    ToPerv
S1               RainGarden       20      200        0          0          20         0
S1               RainBarrel       30      12         0          0          5          0
