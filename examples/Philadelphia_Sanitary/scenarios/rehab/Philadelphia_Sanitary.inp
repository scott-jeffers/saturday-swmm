HOLMESBURG_TRUNK UH_OLDER_TRUNKS  2600.0
TACONY_TRUNK     UH_OLDER_TRUNKS  3400.0
MAYFAIR_TRUNK    UH_OLDER_TRUNKS  3900.0

[CONTROLS]
;; Plant influent pump station: lead, lag and lag-lag pumps by wet-well level, a standby for the highest levels.
RULE WPCP_P1_ON
IF NODE WPCP_WETWELL DEPTH > 7.0
THEN PUMP P_WPCP_1 STATUS = ON
PRIORITY 2

RULE WPCP_P1_OFF
IF NODE WPCP_WETWELL DEPTH < 3.0
THEN PUMP P_WPCP_1 STATUS = OFF
PRIORITY 1

RULE WPCP_P2_ON
IF NODE WPCP_WETWELL DEPTH > 11.0
THEN PUMP P_WPCP_2 STATUS = ON
PRIORITY 2

RULE WPCP_P2_OFF
IF NODE WPCP_WETWELL DEPTH < 7.5
THEN PUMP P_WPCP_2 STATUS = OFF
PRIORITY 1

RULE WPCP_P3_ON
IF NODE WPCP_WETWELL DEPTH > 15.0
THEN PUMP P_WPCP_3 STATUS = ON
PRIORITY 2

RULE WPCP_P3_OFF
IF NODE WPCP_WETWELL DEPTH < 11.5
THEN PUMP P_WPCP_3 STATUS = OFF
PRIORITY 1

RULE WPCP_P4_ON
IF NODE WPCP_WETWELL DEPTH > 20.0
THEN PUMP P_WPCP_4 STATUS = ON
PRIORITY 2

RULE WPCP_P4_OFF
IF NODE WPCP_WETWELL DEPTH < 16.0
THEN PUMP P_WPCP_4 STATUS = OFF
PRIORITY 1

;; Bustleton pump station: duty pump, with the standby joining if the level keeps rising.
RULE BUSTLETON_DUTY_ON
IF NODE PS_BUSTLETON_WW DEPTH > 4.9
THEN PUMP P_BUSTLETON_1 STATUS = ON
PRIORITY 2

RULE BUSTLETON_DUTY_OFF
IF NODE PS_BUSTLETON_WW DEPTH < 1.4
THEN PUMP P_BUSTLETON_1 STATUS = OFF
PRIORITY 1

RULE BUSTLETON_STANDBY_ON
IF NODE PS_BUSTLETON_WW DEPTH > 7.7
THEN PUMP P_BUSTLETON_2 STATUS = ON
PRIORITY 2

RULE BUSTLETON_STANDBY_OFF
IF NODE PS_BUSTLETON_WW DEPTH < 2.8
THEN PUMP P_BUSTLETON_2 STATUS = OFF
PRIORITY 1

;; Equalization basin: drain it back only when the plant's wet well is low, and close the gate when it rises.
RULE EQ_DRAIN_OPEN
IF NODE WPCP_WETWELL DEPTH < 8
AND NODE EQ_BASIN DEPTH > 0.2
THEN ORIFICE G_EQ_DRAIN SETTING = 0.4
PRIORITY 2

RULE EQ_DRAIN_CLOSE
IF NODE WPCP_WETWELL DEPTH > 11
THEN ORIFICE G_EQ_DRAIN SETTING = 0
PRIORITY 3


